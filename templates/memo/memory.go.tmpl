package store

import (
	"context"
	"sync"
	"time"

	"minimal-web-kit/internal/domain"
)

type memorySession struct {
	ownerID    domain.OwnerID
	createdAt  time.Time
	lastSeenAt time.Time
}

type MemoryStore struct {
	mu       sync.RWMutex
	sessions map[string]*memorySession
	memos    map[string]*domain.Memo
}

func NewMemoryStore() *MemoryStore {
	return &MemoryStore{
		sessions: make(map[string]*memorySession),
		memos:    make(map[string]*domain.Memo),
	}
}

func (s *MemoryStore) GetSessionOwner(ctx context.Context, tokenHash string) (domain.OwnerID, error) {
	s.mu.Lock()
	defer s.mu.Unlock()

	sess, ok := s.sessions[tokenHash]
	if !ok {
		return "", ErrNotFound
	}
	sess.lastSeenAt = time.Now()
	return sess.ownerID, nil
}

func (s *MemoryStore) CreateSession(ctx context.Context, tokenHash string, ownerID domain.OwnerID) error {
	s.mu.Lock()
	defer s.mu.Unlock()

	now := time.Now()
	s.sessions[tokenHash] = &memorySession{
		ownerID:    ownerID,
		createdAt:  now,
		lastSeenAt: now,
	}
	return nil
}

func (s *MemoryStore) UpdateSessionSeen(ctx context.Context, tokenHash string) error {
	s.mu.Lock()
	defer s.mu.Unlock()
	if sess, ok := s.sessions[tokenHash]; ok {
		sess.lastSeenAt = time.Now()
	}
	return nil
}

func (s *MemoryStore) DeleteSession(ctx context.Context, tokenHash string) error {
	s.mu.Lock()
	defer s.mu.Unlock()
	delete(s.sessions, tokenHash)
	return nil
}

func (s *MemoryStore) ListMemos(ctx context.Context, ownerID domain.OwnerID) ([]*domain.Memo, error) {
	s.mu.RLock()
	defer s.mu.RUnlock()

	var result []*domain.Memo
	for _, m := range s.memos {
		if m.OwnerID == ownerID {
			copied := *m
			result = append(result, &copied)
		}
	}
	return result, nil
}

func (s *MemoryStore) GetMemo(ctx context.Context, ownerID domain.OwnerID, id string) (*domain.Memo, error) {
	s.mu.RLock()
	defer s.mu.RUnlock()

	m, ok := s.memos[id]
	if !ok || m.OwnerID != ownerID {
		return nil, ErrNotFound
	}
	copied := *m
	return &copied, nil
}

func (s *MemoryStore) CreateMemo(ctx context.Context, memo *domain.Memo) error {
	s.mu.Lock()
	defer s.mu.Unlock()

	copied := *memo
	s.memos[memo.ID] = &copied
	return nil
}

func (s *MemoryStore) UpdateMemo(ctx context.Context, memo *domain.Memo) error {
	s.mu.Lock()
	defer s.mu.Unlock()

	existing, ok := s.memos[memo.ID]
	if !ok || existing.OwnerID != memo.OwnerID {
		return ErrNotFound
	}
	existing.Title = memo.Title
	existing.Content = memo.Content
	existing.UpdatedAt = memo.UpdatedAt
	return nil
}

func (s *MemoryStore) DeleteMemo(ctx context.Context, ownerID domain.OwnerID, id string) error {
	s.mu.Lock()
	defer s.mu.Unlock()

	m, ok := s.memos[id]
	if !ok || m.OwnerID != ownerID {
		return ErrNotFound
	}
	delete(s.memos, id)
	return nil
}

func (s *MemoryStore) DeleteAllData(ctx context.Context, ownerID domain.OwnerID) error {
	s.mu.Lock()
	defer s.mu.Unlock()

	for id, m := range s.memos {
		if m.OwnerID == ownerID {
			delete(s.memos, id)
		}
	}
	for hash, sess := range s.sessions {
		if sess.ownerID == ownerID {
			delete(s.sessions, hash)
		}
	}
	return nil
}

func (s *MemoryStore) PurgeExpiredSessions(ctx context.Context, maxAge time.Duration) (int64, error) {
	s.mu.Lock()
	defer s.mu.Unlock()

	threshold := time.Now().Add(-maxAge)
	expiredOwners := make(map[domain.OwnerID]bool)
	var count int64

	for hash, sess := range s.sessions {
		if sess.lastSeenAt.Before(threshold) {
			expiredOwners[sess.ownerID] = true
			delete(s.sessions, hash)
			count++
		}
	}

	for id, m := range s.memos {
		if expiredOwners[m.OwnerID] {
			delete(s.memos, id)
		}
	}

	return count, nil
}

func (s *MemoryStore) Close() error {
	return nil
}
